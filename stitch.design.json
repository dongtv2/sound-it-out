{
  "$schema": "https://stitch.googleapis.com/schemas/design-tokens/v1.json",
  "name": "Sound It Out - UI/UX Design System",
  "version": "2.0.0",
  "domain": "sound-it-out.metta.family",
  "slogan": "May all beings be happy",
  "typography": {
    "bodyFont": "Inter, sans-serif",
    "headingFont": "Be Vietnam Pro, sans-serif",
    "subsets": ["latin", "vietnamese"]
  },
  "colorPalette": {
    "primary": {
      "emerald500": "#10b981",
      "emerald600": "#059669",
      "teal500": "#14b8a6",
      "teal600": "#0d9488",
      "cyan500": "#06b6d4",
      "cyan600": "#0891b2"
    },
    "accent": {
      "amber400": "#fbbf24",
      "amber500": "#f59e0b",
      "amber600": "#d97706",
      "rose500": "#f43f5e",
      "purple600": "#9333ea"
    },
    "neutral": {
      "slate50": "#f8fafc",
      "slate100": "#f1f5f9",
      "slate800": "#1e293b",
      "slate900": "#0f172a",
      "slate950": "#020617"
    }
  },
  "layoutSystem": {
    "type": "Full-Width Edge-to-Edge",
    "maxWidth": "1700px",
    "paddingX": "px-4 lg:px-8",
    "gridStructure": {
      "asideLeft": "lg:col-span-3 (Bài học được assign)",
      "centerMain": "lg:col-span-6 (Dictation Practice Workspace)",
      "asideRight": "lg:col-span-3 (⭐ Kho Từ Cần Ôn Tập SRS)"
    }
  },
  "components": [
    {
      "id": "TopNavbar",
      "description": "Top sticky navigation header with logo, slogan, role tabs, and theme toggle",
      "file": "src/components/Navbar.tsx"
    },
    {
      "id": "LoginPage",
      "description": "Secure login page with background /metta-portal-bg.jpg and password toggle",
      "file": "src/pages/LoginPage.tsx"
    },
    {
      "id": "DictationPractice",
      "description": "Main 3-column dictation workspace with Web Speech TTS, Vietnamese meaning textbox, and SM-2 SRS buttons",
      "file": "src/components/DictationPractice.tsx"
    },
    {
      "id": "LessonComposer",
      "description": "Lesson authoring tool with text segmentation, MyMemory auto-translation, and learner assignment",
      "file": "src/components/LessonComposer.tsx"
    },
    {
      "id": "AdminPortal",
      "description": "4-Tab Admin portal for Users & RBAC, System Settings, Catalog, and Reports",
      "file": "src/pages/AdminPortal.tsx"
    }
  ]
}
